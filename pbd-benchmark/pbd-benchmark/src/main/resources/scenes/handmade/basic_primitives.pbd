# Reference scene: the 5 base primitives, no modifiers or hierarchy.
# `scale` carries all the sizing - each primitive is defined as a unit
# canonical shape (see README) before the transform is applied.

pbd_version 1

# Canonical plane = unit square in the XZ plane -> 10x10 here after scale.
plane ground {
  pos   = (0, 0, 0)
  scale = (10, 1, 10)
  mat   = grass
}

# Canonical sphere (radius 0.5) + non-uniform scale = ellipsoid, for free.
sphere rock01 {
  pos   = (2, 0.5, -1)
  scale = (0.6, 0.5, 0.55)
  mat   = stone
}

# rot in degrees (X, Y, Z); 90 on Z here to lay the cylinder on its side.
cylinder pipe01 {
  pos   = (2, 0, 0)
  rot   = (0, 0, 90)
  scale = (0.3, 2.0, 0.3)
  mat   = metal
}

cone marker01 {
  pos   = (-1, 0, 1)
  scale = (0.3, 0.6, 0.3)
  mat   = plastic
}

# Canonical cube [-0.5, 0.5]^3; non-uniform scale -> really a box rather
# than a cube in the strict sense, but the `cube` keyword stays the type name.
cube crate01 {
  pos   = (-1, 0.5, -1)
  scale = (1, 1, 1.4)
  mat   = wood
}
