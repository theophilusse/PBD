# Rigged arm: three cylinders in a parent -> child chain. Each `pos` is
# relative to its parent, not to the world -- rotating `upperarm` would
# carry `forearm` along with it (classic forward kinematics, no skinning).

pbd_version 1

# Root of the chain (no `parent`): position expressed in world space.
cylinder shoulder {
  pos   = (0, 1.4, 0)
  scale = (0.15, 0.15, 0.15)
  mat   = skin
}

cylinder upperarm {
  parent = shoulder
  pos    = (0, -0.3, 0)   # relative to shoulder, not to the world
  scale  = (0.1, 0.4, 0.1)
  mat    = skin
}

cylinder forearm {
  parent = upperarm
  pos    = (0, -0.4, 0)   # relative to upperarm
  scale  = (0.08, 0.35, 0.08)
  mat    = skin
}
