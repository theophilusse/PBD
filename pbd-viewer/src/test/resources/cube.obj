# Simple test cube, hard edges (one normal per face, consistent per face).
# Used by ObjParserTest to check deduplication (8 positions x 3 faces each
# = 24 output vertices) and fan triangulation (6 quads -> 12 triangles).
v -1 -1 -1
v  1 -1 -1
v  1  1 -1
v -1  1 -1
v -1 -1  1
v  1 -1  1
v  1  1  1
v -1  1  1
vn 0 0 -1
vn 0 0 1
vn 0 -1 0
vn 0 1 0
vn -1 0 0
vn 1 0 0
f 1/0/1 2/0/1 3/0/1 4/0/1
f 5/0/2 6/0/2 7/0/2 8/0/2
f 1/0/3 2/0/3 6/0/3 5/0/3
f 4/0/4 3/0/4 7/0/4 8/0/4
f 1/0/5 4/0/5 8/0/5 5/0/5
f 2/0/6 3/0/6 7/0/6 6/0/6
